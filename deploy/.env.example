# Copy to deploy/.env and fill in. Never commit the real .env.
HAEM5_DOMAIN=haem5.example.org
POSTGRES_PASSWORD=change-me-long-random
# Generate with:  docker compose run --rm app python -m app.cli gen-keys
HAEM5_DATA_KEY=
HAEM5_JWT_SECRET=
HAEM5_TOKEN_MINUTES=30
HAEM5_REQUIRE_2FA=true
HAEM5_DEMO=false
HAEM5_FIDUCIARY=Department of Pathology, <Institution name>
HAEM5_DPO_NAME=<Name of Data Protection Officer / grievance officer>
HAEM5_DPO_EMAIL=dpo@example.org
HAEM5_DPO_PHONE=+91-00000-00000
HAEM5_DATA_REGION=India (AWS ap-south-1, Mumbai)
HAEM5_RECORD_RETENTION_YEARS=5
HAEM5_LOG_RETENTION_DAYS=365
